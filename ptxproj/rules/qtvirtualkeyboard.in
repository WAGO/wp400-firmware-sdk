## SECTION=elrest_specific_applications

config QTVIRTUALKEYBOARD
	tristate
	prompt "qtvirtualkeyboard"
	select QT6 if QTVIRTUALKEYBOARD_USE_QT6
	help
	  qt based virtual keyboard

if QTVIRTUALKEYBOARD
choice
	prompt "QT_VERSION_USED"
		config QTVIRTUALKEYBOARD_USE_QT5
			bool
			prompt "QT5"

		config QTVIRTUALKEYBOARD_USE_QT6
			bool
			prompt "QT6"
endchoice
endif
